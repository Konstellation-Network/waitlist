# Copy to .env at the repo root and fill in. Read by docker-compose.yml.
# Generate secrets with: openssl rand -hex 32

# --- Postgres (db service; never exposed outside the Docker network) ---
POSTGRES_USER=konstellation
POSTGRES_PASSWORD=change-me
POSTGRES_DB=waitlist

# --- Caddy: the public hostname Caddy serves and gets a TLS cert for ---
DOMAIN=waitlist.example.com

# --- API secrets ---
# Signs the 30-minute survey tokens and keys the IP hash.
JWT_SECRET=change-me-64-hex-chars
# Value of the x-admin-key header for GET /admin/queue.
ADMIN_KEY=change-me-64-hex-chars
# Cloudflare Turnstile secret key (server side).
TURNSTILE_SECRET_KEY=0x4AAAA...

# --- Mailgun (transactional email over the HTTP API) ---
# Private API key from Mailgun -> Settings -> API keys.
MAILGUN_API_KEY=key-...
# Sending domain configured in Mailgun (must be verified).
MAILGUN_DOMAIN=mg.example.com
# https://api.mailgun.net for US-region domains, https://api.eu.mailgun.net for EU.
MAILGUN_API_URL=https://api.mailgun.net
# Sender address; must be on MAILGUN_DOMAIN.
EMAIL_FROM=Konstellation <noreply@mg.example.com>

# --- URLs ---
# Public URL of the web app (verify-link redirects land here). No trailing slash.
APP_URL=https://waitlist.example.com
# Public URL of the API as browsers reach it. Caddy serves both apps on ONE
# origin and proxies /api/* to the API, so in production this MUST be
# https://DOMAIN/api. No trailing slash.
API_URL=https://waitlist.example.com/api
# Comma-separated browser origins allowed by CORS. Same origin as APP_URL.
CORS_ORIGINS=https://waitlist.example.com

# --- Web build args (inlined into the browser bundle at BUILD time) ---
# Must equal API_URL above: https://DOMAIN/api in production.
NEXT_PUBLIC_API_URL=https://waitlist.example.com/api
# Cloudflare Turnstile site key (public, browser side).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAA...
